# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Resend Email Service Configuration
# REQUIRED. The server generates registration OTPs and emails them via Resend.
# Without this key /api/send-verification-otp returns 503 and signup cannot complete.
RESEND_API_KEY=

# Demo auth (DEVELOPMENT ONLY).
# Lets you sign in as the built-in staff/admin accounts without a real auth
# backend. It is compiled out of production builds and is off unless explicitly
# enabled here. Never set these on a deployed environment.
VITE_ALLOW_DEMO_AUTH="false"
VITE_DEMO_AUTH_PASSWORD=""

# PORT: Port the Express server binds to. Defaults to 3000 when unset.
# Most hosts (Cloud Run, Render, Railway) inject this automatically.
PORT=3000
